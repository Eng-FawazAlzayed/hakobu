{
  "manifest_version": 3,
  "name": "Hakobu Download Manager",
  "short_name": "Hakobu",
  "version": "0.3.1",
  "description": "Send links, magnets and downloads to the Hakobu desktop app.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "downloads", "cookies", "scripting", "activeTab", "notifications"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true }]
}
